{
  "name": "spin-a-soccer-card",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "npm run sitemap:sync && next-sitemap --config next-sitemap.config.cjs",
    "start": "next start",
    "lint": "eslint",
    "generate:tdk": "node scripts/generate-detail-tdk.mjs",
    "sitemap:sync": "node scripts/sync-sitemap-lastmod.mjs",
    "sitemap:touch": "node scripts/sync-sitemap-lastmod.mjs --touch",
    "audit:content": "node scripts/audit-content.mjs",
    "audit:data:live": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/audit-live-game-data.ps1",
    "audit:tdk": "node scripts/audit-tdk.mjs",
    "audit:tdk:rendered": "node scripts/audit-rendered-tdk.mjs"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "next-sitemap": "^4.2.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
